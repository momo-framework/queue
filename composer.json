{
    "name": "anidzen/momo-queue",
    "description": "Job queue for Momo: Redis and database transports, handlers per module, concurrent workers in coroutines",
    "version": "0.2.1",
    "type": "library",
    "keywords": [
        "momo",
        "swoole",
        "queue"
    ],
    "homepage": "https://gitlab.com/anidzen/momo/packages/queue",
    "license": "AGPL-3.0-or-later",
    "support": {
        "issues": "https://gitlab.com/anidzen/momo/packages/queue/-/issues",
        "source": "https://gitlab.com/anidzen/momo/packages/queue"
    },
    "authors": [
        {
            "name": "Vahe Sargsyan",
            "email": "w33bv.gl@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "anidzen/momo-console": "^0.1.2",
        "anidzen/momo-kernel": "^0.4.3"
    },
    "require-dev": {
        "anidzen/momo-database": "^0.2",
        "anidzen/momo-redis": "^0.1.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "swoole/ide-helper": "^6.0"
    },
    "suggest": {
        "anidzen/momo-redis": "The redis transport",
        "anidzen/momo-database": "The database transport: jobs commit with your data",
        "ext-swoole": "Concurrent jobs in one worker process"
    },
    "autoload": {
        "psr-4": {
            "Momo\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Momo\\Queue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "momo": {
            "providers": [
                "Momo\\Queue\\QueueServiceProvider"
            ],
            "config": {
                "queue": "config/queue.php"
            },
            "protocols": {
                "Queue": {
                    "description": "Job handlers: __invoke(SomeJob $job), run by queue:work",
                    "vendors": [
                        "Momo\\Queue\\",
                        "Momo\\Bus\\",
                        "Psr\\"
                    ],
                    "readonly": true
                }
            },
            "layers": {
                "Application": [
                    "Momo\\Queue\\Contracts\\",
                    "Momo\\Queue\\Job"
                ]
            }
        }
    },
    "scripts": {
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "lint:check": "php-cs-fixer fix --dry-run --diff",
        "lint": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@rector",
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://reg.anidzen.com/repository/composer/"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
