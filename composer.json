{
    "name": "anidzen/momo-queue",
    "description": "Queue of Momo on RabbitMQ: jobs, #[Queued] commands of the bus, a coroutine worker, failed jobs and retries",
    "version": "0.5.2",
    "type": "library",
    "keywords": [
        "momo",
        "swoole",
        "queue",
        "rabbitmq"
    ],
    "homepage": "https://gitlab.com/anidzen/momo/packages/queue",
    "license": "AGPL-3.0-or-later",
    "support": {
        "issues": "https://gitlab.com/anidzen/momo/packages/queue/-/issues",
        "source": "https://gitlab.com/anidzen/momo/packages/queue"
    },
    "authors": [
        {
            "name": "Vahe Sargsyan",
            "email": "w33bv.gl@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-swoole": "*",
        "anidzen/momo-bus": "^0.3.3",
        "anidzen/momo-console": "^0.3",
        "anidzen/momo-kernel": "^0.5.13",
        "anidzen/momo-server": "^0.2.11",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "anidzen/momo-modules": "^0.12.2",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "swoole/ide-helper": "^6.0"
    },
    "conflict": {
        "anidzen/momo-health": "<0.2"
    },
    "autoload": {
        "psr-4": {
            "Momo\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Momo\\Queue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "momo": {
            "providers": [
                "Momo\\Queue\\QueueServiceProvider"
            ],
            "config": {
                "queue": "config/queue.php"
            },
            "protocols": {
                "Queue": {
                    "description": "Job handlers: __invoke(SomeJob $job), run by queue:work",
                    "vendors": [
                        "Momo\\Queue\\",
                        "Momo\\Bus\\",
                        "Psr\\"
                    ],
                    "readonly": true
                }
            },
            "layers": {
                "Application": [
                    "Momo\\Queue\\Contracts\\",
                    "Momo\\Queue\\Job"
                ]
            },
            "coverage": 76
        }
    },
    "scripts": {
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "lint:check": "php-cs-fixer fix --dry-run --diff",
        "lint": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@rector",
            "@lint:check",
            "@analyse",
            "@test",
            "@arch:check"
        ],
        "arch:check": "momo-arch",
        "coverage": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover=.phpunit.cache/clover.xml",
            "momo-coverage"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://reg.anidzen.com/repository/composer/"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "ext-swoole": "Concurrent jobs in one worker process"
    }
}
